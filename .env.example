# =====================================================
# pet-app — variables de entorno
# Copiar a .env.local en cada apps/* y completar
# NUNCA commitear .env, .env.local ni archivos con secretos reales
# =====================================================

# ----- App -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PetApp

# ----- Supabase -----
# Project URL y anon key (públicos, van al cliente)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (NUNCA exponer al cliente, solo server actions / API routes)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----- Database (Prisma) -----
# DATABASE_URL: con pgbouncer pooling (para queries de la app)
# DIRECT_URL: conexión directa (para migrations de Prisma)
# Detalles: https://supabase.com/docs/guides/database/connecting-to-postgres
DATABASE_URL="postgresql://postgres.xxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ----- Email (Resend) -----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@petapp.example.com
RESEND_REPLY_TO=hola@petapp.example.com

# ----- Google Places (directorio veterinarias) -----
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# ----- Mapbox (alternativa o mapas) -----
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxxxxxxxxxxxx

# ----- Admin (vos) -----
# Email del superadmin inicial — se asigna como admin tras primer signup
ADMIN_BOOTSTRAP_EMAIL=tu-email@ejemplo.com

# ----- Seguridad / rate limit -----
# Upstash Redis para rate limiting (opcional MVP)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----- Premium / WhatsApp para pagos manuales -----
# Número al que el vet escribe cuando quiere upgradearse
NEXT_PUBLIC_PREMIUM_WHATSAPP=5491100000000
NEXT_PUBLIC_PREMIUM_PRICE_USD_MONTHLY=10
NEXT_PUBLIC_PREMIUM_PRICE_USD_YEARLY=100

# ----- Feature flags -----
NEXT_PUBLIC_FEATURE_LOST_MODE=true
NEXT_PUBLIC_FEATURE_DIRECTORY=true

# ----- Cron -----
# Secret usado por Vercel Cron para autenticar /api/cron/*
# Generar con: openssl rand -base64 32
CRON_SECRET=
